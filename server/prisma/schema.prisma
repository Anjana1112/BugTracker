// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
    ADMIN
    DEVELOPER
}

enum TicketStatus {
    OPEN
    IN_PROGRESS
    CLOSED
}

enum TicketPriority {
    LOW
    MEDIUM
    HIGH
}

enum TicketType {
    BUG
    FEATURE
    TASK
}

enum ActivityAction {
    FIELD_CHANGED
    ASSIGNEE_ADDED
    ASSIGNEE_REMOVED
    MEMBER_ADDED
    MEMBER_REMOVED
}

model User {
    userId             Int                @id @default(autoincrement())
    cognitoId          String             @unique
    username           String             @unique
    email              String             @unique
    password           String?
    profilePictureUrl  String?
    role               Role               @default(DEVELOPER)

    authoredTickets    Ticket[]           @relation("TicketAuthor")
    ticketAssignments  TicketAssignment[]
    comments           Comment[]
    projects           Project[]          @relation("ProjectMembers")
    activities         Activity[]

    createdAt          DateTime           @default(now())
    updatedAt          DateTime           @updatedAt
}

model Project {
    projectId          Int                @id @default(autoincrement())
    name               String
    description        String?
    startDate          DateTime?
    endDate            DateTime?

    tickets            Ticket[]
    teamMembers        User[]             @relation("ProjectMembers")
    activities         Activity[]

    createdAt          DateTime           @default(now())
    updatedAt          DateTime           @updatedAt
}

model Ticket {
    ticketId           Int                @id @default(autoincrement())
    title              String
    description        String?
    type               TicketType
    status             TicketStatus
    priority           TicketPriority
    startDate          DateTime?
    dueDate            DateTime?
    createdAt          DateTime           @default(now())
    updatedAt          DateTime           @updatedAt

    projectId          Int
    authorUserId       Int

    project            Project            @relation(fields: [projectId], references: [projectId], onDelete: Cascade)
    author             User               @relation("TicketAuthor", fields: [authorUserId], references: [userId])

    ticketAssignments  TicketAssignment[]
    comments           Comment[]
    activities         Activity[]

    @@index([projectId])
    @@index([authorUserId])
}

model TicketAssignment {
    id                 Int                @id @default(autoincrement())
    userId             Int
    ticketId           Int
    assignedAt         DateTime           @default(now())

    user               User               @relation(fields: [userId], references: [userId], onDelete: Cascade)
    ticket             Ticket             @relation(fields: [ticketId], references: [ticketId], onDelete: Cascade)

    @@unique([userId, ticketId])
    @@index([userId])
    @@index([ticketId])
}

model Comment {
    commentId          Int                @id @default(autoincrement())
    text               String
    ticketId           Int
    userId             Int
    createdAt          DateTime           @default(now())

    ticket             Ticket             @relation(fields: [ticketId], references: [ticketId], onDelete: Cascade)
    author             User               @relation(fields: [userId], references: [userId])
    attachments        CommentAttachment[]

    @@index([ticketId])
    @@index([userId])
}

model CommentAttachment {
    attachmentId       Int                @id @default(autoincrement())
    commentId          Int
    url                String
    originalFilename   String
    mimeType           String
    // Nullable: legacy/seed placeholder rows predate real uploads and have
    // no genuine byte count. Every attachment created through the upload
    // flow always supplies a real size.
    size               Int?
    createdAt          DateTime           @default(now())

    comment            Comment            @relation(fields: [commentId], references: [commentId], onDelete: Cascade)

    @@index([commentId])
}

model Activity {
    activityId         Int                @id @default(autoincrement())
    action             ActivityAction
    // field is only set for FIELD_CHANGED rows (e.g. "status", "title");
    // null for assignee/member add/remove rows.
    field              String?
    oldValue           String?
    newValue           String?
    actorUserId        Int
    // Exactly one of ticketId/projectId is set — enforced in application
    // code, not a DB constraint (no other model in this schema uses one).
    ticketId           Int?
    projectId          Int?
    createdAt          DateTime           @default(now())

    actor              User               @relation(fields: [actorUserId], references: [userId])
    ticket             Ticket?            @relation(fields: [ticketId], references: [ticketId], onDelete: Cascade)
    project            Project?           @relation(fields: [projectId], references: [projectId], onDelete: Cascade)

    @@index([ticketId])
    @@index([projectId])
    @@index([actorUserId])
}
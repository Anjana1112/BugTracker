PORT=8000
# Pooled connection string (Neon "-pooler" host) used by the running app.
DATABASE_URL=postgresql://user:password@host-pooler:5432/dbname
# Optional: direct (non-pooler) connection used by Prisma CLI / migrate deploy.
# Falls back to DATABASE_URL when unset.
DIRECT_URL=postgresql://user:password@host:5432/dbname
JWT_SECRET=replace-with-a-long-random-string

# Allowed CORS origin, i.e. the deployed frontend URL (no trailing slash).
# Unset in development falls back to http://localhost:3000.
CLIENT_ORIGIN=https://your-app.vercel.app

# Optional: bcrypt work factor for password hashing (defaults to 10).
BCRYPT_COST=10

# Optional: max /api/login and /api/register attempts per IP per 15 minutes
# (each route counted separately; defaults to 10).
AUTH_RATE_LIMIT_MAX=10
# Optional: proxy hops to trust for the client IP (X-Forwarded-For).
# Defaults to 1 when NODE_ENV=production (Render), 0 otherwise.
TRUST_PROXY=1

# Cloudflare R2 (S3-compatible object storage) for comment attachments.
# See README/plan for the Cloudflare-side setup steps (bucket, API token, CORS).
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-api-token-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-api-token-secret-access-key
R2_BUCKET_NAME=your-bucket-name
R2_PUBLIC_URL_BASE=https://your-public-bucket-url-or-custom-domain

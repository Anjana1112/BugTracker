# Express API base URL used by the browser (baked in at build time).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Express API base URL used server-side by NextAuth's credentials login.
EXPRESS_API_URL=http://localhost:8000
# Canonical URL of this Next.js app (your Vercel domain in production).
NEXTAUTH_URL=http://localhost:3000
# Secret used to sign NextAuth session JWTs (generate with: openssl rand -base64 32).
NEXTAUTH_SECRET=replace-with-a-long-random-string
# GitHub OAuth app client ID (only needed if GitHub login is enabled).
GITHUB_ID=your-github-oauth-client-id
# GitHub OAuth app client secret (only needed if GitHub login is enabled).
GITHUB_SECRET=your-github-oauth-client-secret
# Set to "true" to show the GitHub sign-in button (off by default; GitHub users can't call the API yet).
NEXT_PUBLIC_ENABLE_GITHUB_LOGIN=false
